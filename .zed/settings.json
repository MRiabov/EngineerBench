{
  "project_name": "P-AI",
  "languages": {
    "Python": {
      "language_servers": [
        "pyrefly",
        "ruff",
        "!pyright",
        "!pylsp"
      ]
    }
  },
  "lsp": {
    "pyrefly": {
      "binary": {
        "path": "/home/maksym/Work/proj/Problemologist/EngineerBench/scripts/pyrefly-zed",
        "arguments": [
          "lsp"
        ]
      },
      "settings": {
        "python": {
          "pythonPath": "/home/maksym/Work/proj/Problemologist/EngineerBench/.venv/bin/python"
        },
        "pyrefly": {
          "project_includes": [
            "**/*.py"
          ],
          "project_excludes": [
            "**/.[!/.]*",
            "**/.venv/**",
            "**/*venv/**",
            "**/__pycache__/**",
            "**/node_modules/**"
          ],
          "search_path": [
            "."
          ],
          "ignore_errors_in_generated_code": true
        }
      }
    }
  },
  "file_scan_exclusions": [
    "**/.jules",
    "**/.kittify",
    "**/.pytest_cache",
    "**/.ruff_cache",
    "**/__pycache__"
  ]
}
